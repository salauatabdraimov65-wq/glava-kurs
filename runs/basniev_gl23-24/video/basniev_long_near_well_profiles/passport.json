  "script": [
    {
      "t_start": 0.15,
      "t_end": 4.02,
      "text": "Уклон у забоя постоянен. А давление тоже?",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Уклон и давление"
    },
    {
      "t_start": 4.52,
      "t_end": 7.5,
      "text": "Предскажите ответ, прежде чем смотреть на кривые.",
      "claim_id": null,
      "is_analogy": false,
      "on_screen": "Ваш прогноз"
    },
    {
      "t_start": 11.0,
      "t_end": 14.81,
      "text": "Сравним пуск скважины при постоянном дебите в трёх представлениях.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Пуск при постоянном дебите"
    },
    {
      "t_start": 15.31,
      "t_end": 18.52,
      "text": "На карте расстояние отсчитывается от центра скважины.",
      "claim_id": "basniev.near_well_profiles#c1",
      "is_analogy": false,
      "on_screen": "Расстояние от скважины"
    },
    {
      "t_start": 19.02,
      "t_end": 22.81,
      "text": "Рядом профиль показывает давление в зависимости от этого расстояния.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Давление и расстояние"
    },
    {
      "t_start": 23.31,
      "t_end": 26.28,
      "text": "Третий график показывает давление на забое во времени.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Давление на забое"
    },
    {
      "t_start": 26.78,
      "t_end": 29.65,
      "text": "Покажем профиль через тысячу секунд после пуска.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Первая тысяча секунд"
    },
    {
      "t_start": 30.15,
      "t_end": 33.63,
      "text": "Теперь добавим профили через четыре и шестнадцать тысяч секунд.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Три момента времени"
    },
    {
      "t_start": 34.13,
      "t_end": 37.31,
      "text": "Кривые относятся к одной скважине с постоянным дебитом.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Дебит не меняется"
    },
    {
      "t_start": 37.81,
      "t_end": 41.67,
      "text": "Автор исследует эти профили, дифференцируя давление по расстоянию.",
      "claim_id": "basniev.near_well_profiles#c1",
      "is_analogy": false,
      "on_screen": "Градиент по расстоянию"
    },
    {
      "t_start": 42.17,
      "t_end": 46.7,
      "text": "Полученная производная показывает градиент: изменение давления с расстоянием.",
      "claim_id": "basniev.near_well_profiles#c2",
      "is_analogy": false,
      "on_screen": "Градиент давления"
    },
    {
      "t_start": 47.2,
      "t_end": 51.3,
      "text": "Вблизи скважины градиент обратно пропорционален расстоянию до неё.",
      "claim_id": "basniev.near_well_profiles#c2",
      "is_analogy": false,
      "on_screen": "Градиент и расстояние"
    },
    {
      "t_start": 51.8,
      "t_end": 55.54,
      "text": "В формуле также присутствуют дебит, вязкость и проницаемость.",
      "claim_id": "basniev.near_well_profiles#c2",
      "is_analogy": false,
      "on_screen": "Параметры в формуле"
    },
    {
      "t_start": 56.04,
      "t_end": 60.08,
      "text": "Но почти постоянный во времени градиент требует отдельного условия.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Проверим условие"
    },
    {
      "t_start": 60.58,
      "t_end": 66.54,
      "text": "Квадрат расстояния должен быть не больше трёх сотых от произведения четырёх, пьезопроводности и времени.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Условие для расстояния"
    },
    {
      "t_start": 67.04,
      "t_end": 71.82,
      "text": "В нашей модели на расстоянии двух метров условие выполнено для всех трёх моментов.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Два метра: условие выполнено"
    },
    {
      "t_start": 72.32,
      "t_end": 76.85,
      "text": "Здесь наклоны профилей почти одинаковы, хотя сами кривые различаются.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Наклоны почти одинаковы"
    },
    {
      "t_start": 77.35,
      "t_end": 81.52,
      "text": "При выполнении условия профили вблизи скважины являются логарифмическими.",
      "claim_id": "basniev.near_well_profiles#c5",
      "is_analogy": false,
      "on_screen": "Логарифмические профили"
    },
    {
      "t_start": 82.02,
      "t_end": 85.57,
      "text": "Теперь посмотрим непосредственно на забой и касательные к кривым.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Касательные на забое"
    },
    {
      "t_start": 86.07,
      "t_end": 89.89,
      "text": "Их углы наклона одинаковы, но точки касания опускаются.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Одинаковый наклон касательных"
    },
    {
      "t_start": 90.39,
      "t_end": 94.43,
      "text": "Значит, при постоянном дебите забойное давление со временем падает.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Забойное давление падает"
    },
    {
      "t_start": 94.93,
      "t_end": 98.98,
      "text": "Это ответ на вопрос: одинаковый наклон не означает одинакового давления.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Наклон не равен давлению"
    },
    {
      "t_start": 99.48,
      "t_end": 103.43,
      "text": "Проверим контрпример дальше от скважины, на расстоянии двадцати метров.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Проверка на удалении"
    },
    {
      "t_start": 103.93,
      "t_end": 107.56,
      "text": "Здесь условие не выполнено ни для одного из показанных моментов.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Условие не выполнено"
    },
    {
      "t_start": 108.06,
      "t_end": 112.86,
      "text": "В этой симуляции наклон там меняется; правило нельзя переносить автоматически.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Правило имеет границы"
    },
    {
      "t_start": 113.36,
      "t_end": 117.09,
      "text": "Как вы проверите условие для другого расстояния и другого момента?",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Проверьте новую точку"
    }
  ],
