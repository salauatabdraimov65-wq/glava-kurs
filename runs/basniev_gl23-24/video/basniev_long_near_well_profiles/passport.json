  "script": [
    {
      "t_start": 0.15,
      "t_end": 6.03,
      "text": "Скважина работает с постоянным дебитом. Почему давление на забое всё равно падает?",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Дебит постоянный"
    },
    {
      "t_start": 6.53,
      "t_end": 9.66,
      "text": "Как ты думаешь, изменится ли при этом наклон у скважины?",
      "claim_id": null,
      "is_analogy": false,
      "on_screen": "Наклон изменится?"
    },
    {
      "t_start": 13.16,
      "t_end": 16.76,
      "text": "Посмотрим на расчёт после запуска скважины с постоянным дебитом.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Запуск скважины"
    },
    {
      "t_start": 17.26,
      "t_end": 21.08,
      "text": "Дебит — это объём жидкости, который скважина выдаёт за время.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Объём за время"
    },
    {
      "t_start": 21.58,
      "t_end": 25.38,
      "text": "На виде сверху цвет показывает, где давление уже снизилось.",
      "claim_id": "basniev.exponential_integral_approximation#c13",
      "is_analogy": false,
      "on_screen": "Снижение давления"
    },
    {
      "t_start": 25.88,
      "t_end": 29.35,
      "text": "На профиле ты видишь давление на разных расстояниях от скважины.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Давление и расстояние"
    },
    {
      "t_start": 29.85,
      "t_end": 33.26,
      "text": "Сохраним эту кривую, чтобы сравнить её с более поздней.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Первый момент"
    },
    {
      "t_start": 33.76,
      "t_end": 37.7,
      "text": "Теперь скважина работает дольше, но её дебит остаётся постоянным.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Позже"
    },
    {
      "t_start": 38.2,
      "t_end": 41.66,
      "text": "На виде сверху зона заметного снижения давления стала шире.",
      "claim_id": "basniev.exponential_integral_approximation#c13",
      "is_analogy": false,
      "on_screen": "Зона шире"
    },
    {
      "t_start": 42.16,
      "t_end": 45.22,
      "text": "На профиле появилась вторая кривая для того же расчёта.",
      "claim_id": "basniev.near_well_profiles#c3",
      "is_analogy": false,
      "on_screen": "Два момента"
    },
    {
      "t_start": 45.72,
      "t_end": 49.37,
      "text": "Сравни кривые возле скважины: поздняя проходит ниже ранней.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Давление ниже"
    },
    {
      "t_start": 49.87,
      "t_end": 52.98,
      "text": "Но у самого забоя наклоны кривых почти одинаковы.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Наклон сохранился"
    },
    {
      "t_start": 53.48,
      "t_end": 57.37,
      "text": "Представь дорожку, которую опускают, сохраняя её наклон.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": true,
      "on_screen": "Дорожка опускается"
    },
    {
      "t_start": 57.87,
      "t_end": 61.53,
      "text": "Но это не цельная дорожка: дальше от скважины наклон меняется.",
      "claim_id": "basniev.exponential_integral_approximation#c13",
      "is_analogy": false,
      "on_screen": "Аналогия ограничена"
    },
    {
      "t_start": 62.03,
      "t_end": 65.88,
      "text": "Сравни оба момента здесь: участки кривых уже не параллельны.",
      "claim_id": "basniev.exponential_integral_approximation#c13",
      "is_analogy": false,
      "on_screen": "Дальняя точка"
    },
    {
      "t_start": 66.38,
      "t_end": 69.8,
      "text": "Значит, одинаковый наклон нельзя переносить на весь пласт.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Не везде"
    },
    {
      "t_start": 70.3,
      "t_end": 73.32,
      "text": "Вернёмся ближе к скважине и сравним наклоны там.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Ближняя точка"
    },
    {
      "t_start": 73.82,
      "t_end": 77.73,
      "text": "Здесь спустя достаточное время наклон почти не зависит от времени.",
      "claim_id": "basniev.near_well_profiles#c4",
      "is_analogy": false,
      "on_screen": "Почти одинаковы"
    },
    {
      "t_start": 78.23,
      "t_end": 83.09,
      "text": "Такой наклон называют градиентом давления: он показывает изменение с расстоянием.",
      "claim_id": "basniev.near_well_profiles#c2",
      "is_analogy": false,
      "on_screen": "Градиент давления"
    },
    {
      "t_start": 83.59,
      "t_end": 87.18,
      "text": "В этой ближней области кривые имеют логарифмическую форму.",
      "claim_id": "basniev.near_well_profiles#c5",
      "is_analogy": false,
      "on_screen": "Форма кривых"
    },
    {
      "t_start": 87.68,
      "t_end": 91.15,
      "text": "А график забойного давления показывает его падение со временем.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Давление на забое"
    },
    {
      "t_start": 91.65,
      "t_end": 94.85,
      "text": "На этом графике время отложено по логарифмической шкале.",
      "claim_id": "basniev.exponential_integral_approximation#c13",
      "is_analogy": false,
      "on_screen": "Шкала времени"
    },
    {
      "t_start": 95.35,
      "t_end": 99.25,
      "text": "Ответ на вопрос: постоянный дебит не удерживает давление на забое.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Ответ"
    },
    {
      "t_start": 99.75,
      "t_end": 102.84,
      "text": "При этом наклон у забоя для показанных кривых одинаков.",
      "claim_id": "basniev.near_well_profiles#c6",
      "is_analogy": false,
      "on_screen": "Два признака"
    },
    {
      "t_start": 103.34,
      "t_end": 107.26,
      "text": "А что ты проверишь, прежде чем сравнивать наклоны дальше от скважины?",
      "claim_id": null,
      "is_analogy": false,
      "on_screen": "Проверишь условие?"
    }
  ],
