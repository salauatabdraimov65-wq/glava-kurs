# Скопируйте в .env и вставьте свой ключ. Файл .env в git не попадает.
OPENAI_API_KEY=
# Дешёвая модель для массовой работы, сильная — только для сложных проверок
LLM_MODEL_BULK=gpt-6-luna
LLM_MODEL_STRONG=
# Предохранитель бюджета, USD на весь проект
LLM_BUDGET_USD=25
# Цены за 1 млн токенов "вход,выход" для учёта бюджета (проверьте на странице цен OpenAI)
LLM_PRICE_BULK=0.10,0.50
LLM_PRICE_STRONG=1.25,10.0
# Папка с материалами организаторов (books md, книги, пакет_вводных). По умолчанию — папка выше репозитория
MATERIALS_DIR=..
